{% extends "base.html.j2" %}
{% block css %}
.media { position: absolute; left: 0; right: 0; top: 0; height: {{ geo.media_h }}px; overflow: hidden; z-index: 1; }
.media img { width: 100%; height: 100%; object-fit: cover; display: block; }
.media .fade { position: absolute; left: 0; right: 0; bottom: 0; height: 160px; background: linear-gradient(180deg, transparent, {{ c.bg_a40 }}); }
.ph { position: absolute; inset: 0; background:
   radial-gradient(520px 420px at 22% 30%, {{ c.accent_a85 }} 0%, transparent 70%),
   radial-gradient(620px 520px at 85% 80%, {{ c.accent2_a80 }} 0%, transparent 70%),
   linear-gradient(135deg, {{ c.surface }} 0%, {{ c.bg }} 100%); }
.ph .c1 { position: absolute; width: 380px; height: 380px; border-radius: 50%; right: 120px; top: 110px;
          border: 3px solid {{ c.on_ph }}; opacity: .5; }
.ph .c2 { position: absolute; width: 180px; height: 180px; border-radius: 50%; left: 150px; bottom: 120px;
          background: {{ c.on_ph }}; opacity: .18; }
.ph .ln { position: absolute; left: 90px; right: 90px; top: 50%; height: 2px; background: {{ c.on_ph }}; opacity: .25; }
.ph .grain2 { position: absolute; inset: 0; opacity: .22; mix-blend-mode: overlay;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='300' height='300'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>"); }
.layout-split_image .h { font-size: calc(var(--k) * var(--hs) * 72px); }
.layout-split_image .body { font-size: calc(var(--kb) * 36px); margin-top: calc(var(--k) * 30px); }
.layout-split_image ul { list-style: none; margin-top: calc(var(--k) * 20px); }
.layout-split_image li { position: relative; padding-left: 1.1em; margin-top: .4em; }
.layout-split_image li::before { content: ""; position: absolute; left: 0; top: .55em; width: .42em; height: .42em; border-radius: 50%; background: var(--accent); }
{% endblock %}
{% block background %}
  <div class="media">
    {% if image_uri %}<img src="{{ image_uri }}" alt="">{% else %}
    <div class="ph"><div class="c1"></div><div class="c2"></div><div class="ln"></div><div class="grain2"></div></div>{% endif %}
    <div class="fade"></div>
  </div>
{% endblock %}
{% block inner_class %}v-center align-left{% endblock %}
{% block content %}
  {% if s.kicker %}<div class="kicker">{{ s.kicker }}</div>{% endif %}
  <h2 class="h">{{ s.heading }}</h2>
  {% if s.body or s.bullets %}
  <div class="body">
    {% if s.body %}{{ s.body }}{% endif %}
    {% if s.bullets %}<ul>{% for b in s.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
  </div>
  {% endif %}
{% endblock %}
