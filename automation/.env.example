# Copy this file to .env (never commit .env) and fill it in.

PORT=3000
DATA_FILE=./data/store.json

# Password for the admin inbox at /admin (username: admin). Required.
ADMIN_PASSWORD=

# --- WhatsApp Business Cloud API (from developers.facebook.com > your app > WhatsApp) ---
# Leave WHATSAPP_TOKEN empty to run in dry-run mode (nothing is actually sent).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App settings > Basic > App secret. Used to check that webhooks really come from Meta.
WHATSAPP_APP_SECRET=
# Any random string you make up. Paste the same value into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=en

# Names of your approved templates (see README).
TEMPLATE_OPENER=kortexa_continue
TEMPLATE_FOLLOWUP_1=kortexa_followup_1
TEMPLATE_FOLLOWUP_2=kortexa_followup_2
SEND_OPENER=true

# Follow-up timing (Ghana time = UTC).
FOLLOWUP_1_DAYS=2
FOLLOWUP_2_DAYS=5
SEND_FROM_HOUR=9
SEND_UNTIL_HOUR=18
CHECK_EVERY_MINUTES=15
DAILY_CAP=200

# --- AI replies with Claude ---
# off   = you reply yourself from /admin
# draft = Claude suggests a reply, you approve it with one click (recommended to start)
# auto  = Claude replies by itself (still hands prices/complaints to you)
AI_MODE=draft
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
SENDER_NAME=
# Optional: a calendar booking link (e.g. Calendly) the AI shares when they want a call.
BOOKING_LINK=
# Optional: path to your own facts file. Defaults to kortexa-facts.md.
KORTEXA_FACTS_FILE=
