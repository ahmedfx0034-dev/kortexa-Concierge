# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
STUDIO_MODEL=claude-opus-5-5
STUDIO_EFFORT=high

# Apify — optional; only needed to pull carousels from post links / @handles
# (screenshots work without it)
APIFY_TOKEN=

# Instagram Graph API (Business/Creator account linked to a Facebook Page)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v23.0

# Where slide images are uploaded so Instagram can fetch them (must be public HTTPS)
IMAGE_HOST=vercel        # vercel (recommended), s3 (AWS S3 / Cloudflare R2) or local
BLOB_READ_WRITE_TOKEN=   # Vercel → Storage → your Blob store → .env.local tab
S3_BUCKET=
S3_ENDPOINT_URL=         # e.g. https://<account>.r2.cloudflarestorage.com  (blank for AWS)
S3_PUBLIC_BASE_URL=      # e.g. https://pub-xxxx.r2.dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PUBLIC_BASE_URL=         # only for IMAGE_HOST=local: public URL that serves data/drafts/
